NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dhanlaxmi
# Owner PIN for /settings — required to view/change app expiry (even when locked)
APP_OWNER_PIN=
WHATSAPP_INSTANCE_ID=
WHATSAPP_BEARER_TOKEN=
WHATAPP_API=https://goapichatnexa.nnsolutions.co.in/whatsapp/send
# Text API credentials above are required for vendor alerts, automatic customer
# booking confirmations, and direct category shares. Set the connected WhatsApp
# business profile display name to "Dhanlaxmi Caterer" in your provider/account.
# SMS Tech Hub — template WhatsApp for new-order vendor alerts & confirmations
# GET …/sendmsgutil.php?user=&pass=&sender=&phone=&text=TEMPLATE&priority=wa&stype=normal&Params=…
WHATSAPP_HUB_URL=http://smstechhub.nnsolutions.co.in/api/sendmsgutil.php
WHATSAPP_HUB_USER=
WHATSAPP_HUB_PASS=
WHATSAPP_HUB_SENDER=BUZWAP
# Exact approved template name on BUZWAP for vendor order alerts (text=…)
# Template: order_alert_final — params: {{1}}=date, {{2}}=venue, {{3}}=materials, {{4}}=notes
WHATSAPP_ORDER_TEMPLATE="order_alert_final"
# Exact approved template name on BUZWAP for customer booking confirmations
# Must be a dedicated customer template; never use order_alert_final here.
# Template: order_pdf — body: "Hello User, Kindly find the menu. Thankyou." (PDF sent separately via ChatNexa)
WHATSAPP_BOOKING_TEMPLATE="order_pdf"
# WhatsApp request/response debug logs (default on). Set 0/false/off to silence.
WHATSAPP_DEBUG=1
