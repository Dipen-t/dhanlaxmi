NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/dhanlaxmi
# Owner PIN for /settings — required to view/change app expiry (even when locked)
APP_OWNER_PIN=
WHATSAPP_INSTANCE_ID=
WHATSAPP_BEARER_TOKEN=
WHATAPP_API=https://goapichatnexa.nnsolutions.co.in/whatsapp/send
# Text API credentials above are required for vendor alerts, automatic customer
# booking confirmations, and direct category shares. Set the connected WhatsApp
# business profile display name to "Dhanlaxmi Caterer" in your provider/account.
# SMS Tech Hub — template WhatsApp for new-order vendor alerts
# GET …/sendmsg.php?user=&pass=&sender=&phone=&text=TEMPLATE&priority=wa&stype=normal&Params=…
WHATSAPP_HUB_URL=http://smstechhub.nnsolutions.co.in/api/sendmsg.php
WHATSAPP_HUB_USER=
WHATSAPP_HUB_PASS=
WHATSAPP_HUB_SENDER=BUZWAP
# Exact approved template name on BUZWAP (text=…)
WHATSAPP_ORDER_TEMPLATE="New Order Alert"
# WhatsApp request/response debug logs (default on). Set 0/false/off to silence.
WHATSAPP_DEBUG=1
